# Required for the ingest-worker to talk to Supabase + Mapbox.
# Copy this file to .env.local and fill in values; populate the same
# vars in the Railway service dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MAPBOX_TOKEN=

# Optional CSV gate (e.g. "gcal" to run only Google Calendar during
# a manual debug run). Leave blank in production.
INGEST_SOURCES=

# For log readability when streaming through `railway logs`. Does
# NOT affect cron schedule, which Railway evaluates in UTC.
TZ=America/Chicago
