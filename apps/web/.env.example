# Copy this file to apps/web/.env.local and fill in real values.
# .env.local is gitignored; .env.example is committed as the canonical list.
#
# Validation runs at module load in apps/web/lib/env.ts. A missing
# required key throws on first import with a named error rather than
# crashing silently inside a request handler in production.

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Set after creating the webhook endpoint in the Clerk dashboard.
# Endpoint URL: <vercel-domain>/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's new "publishable key" (sb_publishable_*) — replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by lib/supabase/admin.ts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Mapbox (public token, restrict to localhost + Vercel domains) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Anthropic (flyer extraction, /api/admin/flyers/extract) ---
# Server-only. Route returns 503 when absent so dev builds without the
# key still work.
ANTHROPIC_API_KEY=
# Defaults below; override per-environment as needed.
FLYER_EXTRACT_MODEL=claude-sonnet-4-6
FLYER_EXTRACT_DAILY_CAP=100
